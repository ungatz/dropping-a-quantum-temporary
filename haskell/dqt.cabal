cabal-version:      2.4
name:               dqt
version:            0.1.0
synopsis:           The affine drop calculus, its checker, and the drop criterion
description:
  A self-contained implementation of the language studied in
  /Dropping a Quantum Temporary/: the measurement-free affine calculus, its
  type checker, its two semantics, the drop criterion by two independent
  routes, the constructive witness synthesiser that realises the right-to-left
  direction of the criterion as source text, the client that realises the
  contextual reading, the bundling elaboration that carries many temporaries
  into the one-temporary core, and the lifted calculus with dynamic lifting
  together with the runtime check.
  .
  The package holds two implementations of one criterion.  The theory layer
  builds the core map as a matrix and takes an exact rank; the surface
  language never builds it, and probes instead.  DQT.Bridge runs them against
  each other.
  .
  Exact arithmetic throughout, and a check that asserts no inexact numeric
  type occurs anywhere in the sources.  Reading order is in README.md.
build-type:         Simple
extra-doc-files:    README.md

common lang
    default-language: GHC2021
    ghc-options:      -Wall -Wcompat -Widentities
                      -Wincomplete-record-updates
                      -Wmissing-home-modules
                      -Wredundant-constraints

library
    import:           lang
    hs-source-dirs:   src
    exposed-modules:  DQT
                      DQT.Algebra.Linear
                      DQT.Algebra.Scalar
                      DQT.Bridge
                      DQT.Calculus.Elaborate
                      DQT.Calculus.Gates
                      DQT.Calculus.Machine
                      DQT.Calculus.Metatheory
                      DQT.Calculus.Syntax
                      DQT.Calculus.Typing
                      DQT.Corpus.Classical
                      DQT.Corpus.Examples
                      DQT.Corpus.Producer
                      DQT.Corpus.Isolable
                      DQT.Criterion
                      DQT.Criterion.Context
                      DQT.Criterion.Gram
                      DQT.Criterion.Split
                      DQT.Criterion.Witness
                      DQT.Lifted
                      DQT.Lifted.Programs
                      DQT.Many.Multi
                      DQT.Many.Nested
                      DQT.Many.Release
                      DQT.Pretty
                      DQT.Report
                      DQT.Residual
                      S.Lang.Cyclo
                      S.Lang.Gates
                      S.Lang.Interp
                      S.Lang.Parser
                      S.Lang.QState
                      S.Lang.Ring
                      S.Lang.Syntax
                      S.Pass
                      S.Pass.Cut
                      S.Pass.Decide
                      S.Pass.Park
                      S.Pass.Resolve
                      S.Programs.BV
                      S.Programs.DJ
                      S.Programs.Grover
                      S.Programs.QFT
                      S.Programs.QPE
                      S.Programs.RUS
                      S.Programs.Shor
                      S.Programs.Simon
                      S.Programs.Superdense
                      S.Programs.Teleport
                      S.Programs.TempAnd
                      S.Programs.Tilt
                      S.Report.Explain
                      S.Report.Run
                      S.Report.Trace
                      S.Suite
                      S.Test.Exhaustive
                      S.Test.Parser
                      S.Test.Pass
    build-depends:    base >=4.14 && <5

executable dqt
    import:           lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base, dqt

test-suite dqt-test
    import:           lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    -- `directory` so that the two directory-walking gates report a missing
    -- directory as a failed check rather than dying with an exception: a
    -- renamed directory must turn a check red, never crash the suite.
    build-depends:    base, directory, dqt
