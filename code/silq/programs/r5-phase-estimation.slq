// Row 5, phase estimation.  Two registers: the precision register, which is
// measured, and the eigenstate register u, which the algorithm leaves on the
// eigenstate line and must then discard.  The criterion of this work admits
// that drop, the temporary being parked on the eigenstate line.  Here U = X,
// whose eigenstates are |+> at phase 0 and |-> at phase 1/2, and the run is on
// |u> = |->, so the answer is 0.5.
def QFT[n:!N](psi: uint[n]) mfree: uint[n] {
	for k in [0..n div 2) { (psi[k], psi[n-k-1]) := (psi[n-k-1], psi[k]); }
	for k in [0..n) {
		psi[k] := H(psi[k]);
		for l in [k+1..n) { if psi[k] && psi[l] { phase(2*pi*2^(k-l-1)); } }
	}
	return psi;
}

def phaseEstimation(precision: !N): !uint[precision] {
	u := H(0:B); u := Z(u); u := H(u);   // |u> = X|-> ... prepare |-> as H|1>
	ancilla := 0:uint[precision];
	for i in [0..precision) { ancilla[i] := H(ancilla[i]); }
	for i in [0..precision) {
		if ancilla[i] { for l in [0..2^i) { u := X(u); } }
	}
	ancilla := reverse(QFT[precision])(ancilla);
	result := measure(ancilla);
	forget(u);        // THE DROP UNDER TEST: u is still the eigenstate |->
	return result;
}

def main() { return phaseEstimation(3); }
