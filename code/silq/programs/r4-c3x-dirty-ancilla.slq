// Row 4, C^3X with one borrowed dirty ancilla, four Toffolis:
//   t ^= c.d ; d ^= a.b ; t ^= c.d ; d ^= a.b   leaves t ^= a.b.c and d as it
// was.  The dirty ancilla d is in an unknown state and must be handed back in
// it.  Silq has no borrow construct, so the only spelling is to pass it in and
// hand it back: the caller owns d and nothing about its restoration is checked.
def c3x(const a: B, const b: B, const c: B, t: B, d: B): B x B {
	if c && d { t := X(t); }
	if a && b { d := X(d); }
	if c && d { t := X(t); }
	if a && b { d := X(d); }
	return (t, d);
}

def main() {
	// dirty ancilla: an arbitrary, non-|0> state the borrower does not know
	d := H(0:B);
	d := T(d);
	(a, b, c) := (1:B, 1:B, 1:B);
	t := 0:B;
	(t, d) := c3x(a, b, c, t, d);
	// undo the dirty preparation: if d really was restored this returns |0>
	d := reverse(T)(d);
	d := H(d);
	return (measure(t), measure(d), measure(a), measure(b), measure(c));
}
