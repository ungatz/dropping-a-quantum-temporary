// Row 3, Grover with a compute-uncompute oracle.  The oracle bit is computed
// into a temporary a, used to apply the phase, and then dropped.  The
// criterion of this work admits the drop, which is parked on [|0>], and the
// forget(a) below is automatic uncomputation with no witness supplied.
def diffusion[n:!N](cand: uint[n]) mfree: uint[n] {
	for k in [0..n) { cand[k] := H(cand[k]); }
	if cand != 0 { phase(pi); }
	for k in [0..n) { cand[k] := H(cand[k]); }
	return cand;
}

def grover[n:!N](const f: const uint[n] !-> lifted B): !N {
	nIterations := floor(pi/(4*asin(2^(-n/2))));
	cand := 0:uint[n];
	for k in [0..n) { cand[k] := H(cand[k]); }
	for k in [0..nIterations) {
		a := f(cand);        // COMPUTE the oracle bit into a temporary
		if a { phase(pi); }  // USE it
		forget(a);           // THE DROP UNDER TEST -- automatic uncomputation
		cand := diffusion(cand);
	}
	return measure(cand) as !N;
}

def main() {
	def f(const x: uint[4]) lifted: B { return x == 11; }
	return grover(f);
}
