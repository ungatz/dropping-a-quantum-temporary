// Row 8 control: a deliberately wrong witness, forget(q = 0), where q is |3>.
//
// Row 8, a real repeat-until-success iteration written with while.  Rejection
// sampling: two qubits in uniform superposition over {0,1,2,3}; an ancilla
// flag holds (q == 3); the flag is measured, which is a lifted outcome.  On
// failure the failed attempt is dropped and the iteration repeats; on success
// the surviving q is uniform over {0,1,2} and is returned live.  This is the
// outcome-dependent shape: the drop of q is safe only on the failure branch,
// where the measurement has already collapsed q to |3>.
def prepare3(): uint[2] {
	q := 0:uint[2];
	for k in [0..2) { q[k] := H(q[k]); }
	flag := q == 3;
	f := measure(flag);
	while f {
		forget(q = 0);   // WRONG witness: q is |3> here, not |0>
		q := 0:uint[2];
		for k in [0..2) { q[k] := H(q[k]); }
		flag := q == 3;
		f = measure(flag);
	}
	return q;                     // uniform over {0,1,2}
}

def main() { return prepare3(); }
