// Row 7, teleportation, complete and runnable.  Alice holds msg and her half a
// of a Bell pair; Bob holds b.  Alice Bell-measures (msg, a), so both
// temporaries are consumed by measure, and Bob corrects b with the two lifted
// outcomes.
//
// The check: prepare msg = T(H|0>), teleport, then run the inverse preparation
// on Bob's qubit.  If teleportation worked the result is |0> with probability
// 1 on every seed.
def teleport(msg: B): B {
	// Bell pair
	a := H(0:B);
	b := 0:B;
	if a { b := X(b); }
	// Alice's Bell measurement -- the two temporaries are dropped here
	if msg { a := X(a); }
	msg := H(msg);
	(m0, m1) := (measure(msg), measure(a));
	// Bob's correction, classically controlled on the lifted outcomes
	if m1 { b := X(b); }
	if m0 { b := Z(b); }
	return b;
}

def main() {
	m := T(H(0:B));            // an arbitrary state to send
	out := teleport(m);
	out := reverse(T)(out);    // undo the preparation on Bob's qubit
	out := H(out);
	return measure(out);       // must be 0 on every seed if teleportation works
}
