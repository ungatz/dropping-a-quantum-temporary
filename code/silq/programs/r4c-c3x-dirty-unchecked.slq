// Row 4, the unchecked-promise probe.  The same signature as the row's main
// program, but the last Toffoli is deleted, so the dirty ancilla is not
// restored.  If this type-checks, no dirty-ancilla check is performed at all.
def c3x_broken(const a: B, const b: B, const c: B, t: B, d: B): B x B {
	if c && d { t := X(t); }
	if a && b { d := X(d); }
	if c && d { t := X(t); }
	// MISSING: if a && b { d := X(d); }
	return (t, d);
}

def main() {
	d := H(0:B); d := T(d);
	(a, b, c) := (1:B, 1:B, 1:B);
	t := 0:B;
	(t, d) := c3x_broken(a, b, c, t, d);
	d := reverse(T)(d); d := H(d);
	return (measure(t), measure(d));
}
