// Row 6, superdense coding.  A Bell pair (a, b); Alice encodes two classical
// bits into her half a; Bob decodes with a controlled X and a Hadamard and
// reads both bits out.
def superdense(const b0: !B, const b1: !B): !B x !B {
	// shared Bell pair
	a := H(0:B);
	b := 0:B;
	if a { b := X(b); }
	// Alice encodes
	if b1 { a := X(a); }
	if b0 { a := Z(a); }
	// Bob decodes
	if a { b := X(b); }
	a := H(a);
	return (measure(a), measure(b));
}

def main() {
	assert(superdense(0:!B, 0:!B) == (0:!B, 0:!B));
	assert(superdense(0:!B, 1:!B) == (0:!B, 1:!B));
	assert(superdense(1:!B, 0:!B) == (1:!B, 0:!B));
	assert(superdense(1:!B, 1:!B) == (1:!B, 1:!B));
	return superdense(1:!B, 0:!B);
}
