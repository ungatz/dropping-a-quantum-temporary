// Row 5 control: the same phase estimation with U = Z and the eigenstate
// |u> = |1> = X|0>, preparable by the qfree gate X.  Same phase, same
// parked-on-an-eigenstate drop.  Accepting forget(u) here would show that the
// refusal in the row's main program is about the producer, not the state.
def QFT[n:!N](psi: uint[n]) mfree: uint[n] {
	for k in [0..n div 2) { (psi[k], psi[n-k-1]) := (psi[n-k-1], psi[k]); }
	for k in [0..n) {
		psi[k] := H(psi[k]);
		for l in [k+1..n) { if psi[k] && psi[l] { phase(2*pi*2^(k-l-1)); } }
	}
	return psi;
}

def phaseEstimation(precision: !N): !uint[precision] {
	u := X(0:B);                        // |u> = |1>, eigenstate of Z, prepared QFREE
	ancilla := 0:uint[precision];
	for i in [0..precision) { ancilla[i] := H(ancilla[i]); }
	for i in [0..precision) {
		if ancilla[i] { for l in [0..2^i) { u := Z(u); } }
	}
	ancilla := reverse(QFT[precision])(ancilla);
	result := measure(ancilla);
	forget(u);        // THE SAME DROP, on a qfree-produced eigenstate
	return result;
}

def main() { return phaseEstimation(3); }
