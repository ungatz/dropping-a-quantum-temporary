// Row 4, the borrow itself.  A local scratch qubit in an unknown state, used,
// then released at the end of the block.  Silq's only local allocation is the
// clean 0:B, so the nearest spelling of a dirty scratch is to put a fresh
// qubit into an unknown state and release it.
def c3x_dirty_local(const a: B, const b: B, const c: B, t: B): B {
	d := H(0:B);              // the closest thing to `borrow` Silq can write
	d := T(d);                // ... in a genuinely unknown state
	if c && d { t := X(t); }
	if a && b { d := X(d); }
	if c && d { t := X(t); }
	if a && b { d := X(d); }
	forget(d);                // THE RELEASE -- d is back in its lent state
	return t;
}

def main() {
	(a, b, c) := (1:B, 1:B, 1:B);
	return measure(c3x_dirty_local(a, b, c, 0:B));
}
