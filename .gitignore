abstract/*.aux
abstract/*.bbl
abstract/*.blg
abstract/*.fls
abstract/*.fdb_latexmk
abstract/*.log
abstract/*.out
abstract/*.synctex.gz
abstract/figures/*.aux
abstract/figures/*.log
abstract/figures/*.fls
abstract/figures/*.fdb_latexmk
abstract/figures/*.synctex.gz

