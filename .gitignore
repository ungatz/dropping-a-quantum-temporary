.DS_Store

# LaTeX build products. The figures are drawn standalone and `make` redraws
# them, so only their sources are kept; narrative/full.pdf is committed on
# purpose, so that the paper can be read without a TeX installation.
narrative/build/
narrative/figures/*.pdf
!narrative/figures/barenco-original.pdf
narrative/figures/*.aux
narrative/figures/*.log
narrative/figures/*.fls
narrative/figures/*.fdb_latexmk
narrative/figures/*.synctex.gz

